<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="collective.matomoaitracker"
    >

  <include
      package="Products.CMFCore"
      file="permissions.zcml"
      />

  <browser:page
      name="matomo-ai-controlpanel"
      for="Products.CMFCore.interfaces.ISiteRoot"
      class="collective.matomoaitracker.browser.controlpanel.MatomoAITrackingControlPanelView"
      permission="cmf.ManagePortal"
      />

  <browser:page
      name="matomoaitracker"
      for="*"
      class=".tracking.MatomoVarnishLogConsumerView"
      permission="cmf.ManagePortal"
      />


</configure>
