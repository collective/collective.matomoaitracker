# Copy to .env to configure the Docker stack (make stack-start).

# Matomo instance the AI bot requests are tracked in.  The default is the fake
# Matomo of the stack, which `make stack-test` needs.
#MATOMO_BASE_URL=https://matomo.example.com
# token_auth of a Matomo user with write access to the sites.
#MATOMO_AI_TOKEN_AUTH=
# Site whose AI Chatbots report gets the AI assistant requests.
MATOMO_SITE_ID=1
# Separate site that gets every AI bot request as a visit, with the custom
# dimensions for the bot category and the cache status.
MATOMO_BOT_SITE_ID=2
MATOMO_DIMENSION_CATEGORY=1
MATOMO_DIMENSION_CACHE=2

# Password of the Plone service user the shipper logs in with.
MATOMO_AI_SHIPPER_PASSWORD=shipper-secret

# Delete and recreate the Plone site on every start of the Plone container.
DELETE_EXISTING=False

# Port Varnish listens on, browsers block some ports such as 10080.
VARNISH_PORT=8001
# Port Nginx listens on.
NGINX_PORT=8002
# Port Plone listens on.
PLONE_PORT=8003
# Port of the fake Matomo.
MATOMO_PORT=8004
